{
  "name": "dvm-run",
  "version": "0.2.0",
  "description": "Sandboxes whose every run replays: dvm.run's JavaScript SDK",
  "license": "Apache-2.0",
  "homepage": "https://dvm.run",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deterministic-machines/sdk.git",
    "directory": "js"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "dvm-run": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc",
    "prepack": "npm run build",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
